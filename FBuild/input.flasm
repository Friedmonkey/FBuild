declare string choice;
declare const string rock = "rock";
declare const string paper = "paper";
declare const string shears = "shears";

// ask player
:starth
push string "rock, paper, or shears? "
syscall print

push choice
syscall read

// check valid input
push choice
jump_if_stack rock correct_input
jump_if_stack paper correct_input
jump_if_stack shears correct_input

push string "invalid input"
push 1b
exit

:correct_input
// computer random 0..2
push 0b
push 2b
math rand

// computer chooses
jump_if_stack 0b computer_rock
jump_if_stack 1b computer_paper
jump_if_stack 2b computer_shears

:computer_rock
push choice
jump_if_stack rock draw
jump_if_stack paper player_wins
jump_if_stack shears computer_wins

:computer_paper
push choice
jump_if_stack rock computer_wins
jump_if_stack paper draw
jump_if_stack shears player_wins

:computer_shears
push choice
jump_if_stack rock player_wins
jump_if_stack paper computer_wins
jump_if_stack shears draw

:player_wins
push string "you win!"
syscall println
jump retry

:computer_wins
push string "computer wins!"
syscall println
jump retry

:draw
push string "draw!"
syscall println
jump retry

:retry
pop
pop
jump starth

